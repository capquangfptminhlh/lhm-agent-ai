# Local development only. Do not commit a real API key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# Default is DeepSeek for backward compatibility; select openrouter for free-first.
LHM_LLM_PROVIDER=deepseek
# Free router may choose different models across requests.
# For consistent quality you may pin a vetted provider/model:free slug instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Local safety limits; account-wide OpenRouter usage may be higher.
LHM_OPENROUTER_24H_LIMIT=40
LHM_OPENROUTER_1M_LIMIT=15
# Default deny sending common personal-contact data to free model providers.
LHM_OPENROUTER_ALLOW_CONTACT_DATA=0
LHM_DB_PATH=./lhm.sqlite3
LHM_ACTIVE_WORKSPACE=demo
# Optional access token; required before exposure outside localhost.
LHM_ADMIN_TOKEN=
# Reserve an upper-bound amount for each concurrent task. Remaining reservation released at completion.
LHM_TASK_RESERVE_USD=0.02

# Advanced model is disabled by default. It costs more.
LHM_ALLOW_PRO=0

# Tool Hub: pilot integration ONLY for this one workspace.
# For real SaaS use per-customer OAuth, encrypted credential vault, and permissions.
LHM_TOOLS_WORKSPACE=demo

# Postiz (https://docs.postiz.com/public-api/introduction)
# Cloud example: https://api.postiz.com/public/v1
# Self-host: put the verified Postiz instance public API base here.
LHM_POSTIZ_API_KEY=
LHM_POSTIZ_BASE_URL=https://api.postiz.com/public/v1

# WordPress: create an Application Password in WordPress (HTTPS required).
LHM_WP_URL=
LHM_WP_USER=
LHM_WP_APP_PASSWORD=

# Activepieces: create a Webhook trigger Flow and paste its HTTPS URL.
LHM_ACTIVEPIECES_WEBHOOK_URL=

# Specialist Agent Tools — run externally; never commit real credentials.
# Crawl4AI 0.9+ self-host: requires bearer token.
# Or choose LHM_CRAWL4AI_MODE=cloud (uses https://api.crawl4ai.com/scrape).
LHM_CRAWL4AI_MODE=selfhost
LHM_CRAWL4AI_URL=http://127.0.0.1:11235
LHM_CRAWL4AI_TOKEN=
# Exact public HTTPS domains only, comma-separated. Required! Example: example.com,news.example.com
LHM_CRAWL_ALLOWED_HOSTS=

# Twenty CRM (cloud: https://api.twenty.com; self-host needs HTTPS).
LHM_TWENTY_URL=https://api.twenty.com
LHM_TWENTY_API_KEY=

# Chatwoot Application API. Choose an account ID with contact-create permission.
LHM_CHATWOOT_URL=
LHM_CHATWOOT_API_TOKEN=
LHM_CHATWOOT_ACCOUNT_ID=

# ComfyUI: local instance, choose one installed trusted checkpoint filename.
# No arbitrary code, custom nodes or arbitrary graph are accepted by LHM.
LHM_COMFYUI_URL=http://127.0.0.1:8188
LHM_COMFYUI_CHECKPOINT=

# Codex-style Computer Runner (separate sidecar, disabled until configured).
# Generate a long random shared token locally, use the SAME token in API/worker and runner.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
LHM_COMPUTER_RUNNER_TOKEN=
LHM_COMPUTER_URL=http://computer:7781
# Exact HTTPS hostnames the browser can visit. No wildcards or IP literals.
LHM_COMPUTER_ALLOWED_HOSTS=
# Default requires human approval before every file write, terminal command or browser click/fill.
LHM_COMPUTER_AUTO_WRITE=0
# Only for Computer Runner sidecar, not necessary for the main app.
LHM_COMPUTER_HOME=/agent-data

# Robot vision: explicit user opt-in and an OpenRouter model that supports images.
# Use ONLY a vision-capable model slug ending in :free; never silently bill.
LHM_COMPUTER_VISION_ENABLED=0
LHM_COMPUTER_VISION_MODEL=

# Optional Docker Desktop code sandbox for installed Windows Robot only.
# Operator must first pull the trusted fixed image: docker pull python:3.12-slim
LHM_SANDBOX_ENABLED=0

# Number of independent coworker LLM tasks (different roles) processed concurrently.
# Choose 1-4; 1 is the safe default for free model quotas.
LHM_AGENT_PARALLELISM=1

# Repository-bound CI agents: public repos work without a token.
# For private repos, set one fine-grained read-only GitHub token with Actions:read and Metadata:read.
# Do NOT put tokens in the browser UI or give a repo runner write permission for CI inspection.
LHM_GITHUB_READ_TOKEN=



# 16 department-specific Activepieces webhook endpoints (each Flow configured separately).
# Operator-only credentials: never paste signed webhook URLs into browser, chat or source control.
# Leaving a URL blank DISABLES that department's workflow. HTTPS required except local test.
LHM_DEPARTMENT_DIRECTOR_WEBHOOK_URL=
LHM_DEPARTMENT_RESEARCH_WEBHOOK_URL=
LHM_DEPARTMENT_STRATEGY_WEBHOOK_URL=
LHM_DEPARTMENT_LEAD_WEBHOOK_URL=
LHM_DEPARTMENT_CONTENT_WEBHOOK_URL=
LHM_DEPARTMENT_ADS_WEBHOOK_URL=
LHM_DEPARTMENT_CRM_WEBHOOK_URL=
LHM_DEPARTMENT_SALES_WEBHOOK_URL=
LHM_DEPARTMENT_QUALITY_WEBHOOK_URL=
LHM_DEPARTMENT_ANALYTICS_WEBHOOK_URL=
LHM_DEPARTMENT_OPERATIONS_WEBHOOK_URL=
LHM_DEPARTMENT_FINANCE_WEBHOOK_URL=
LHM_DEPARTMENT_HR_WEBHOOK_URL=
LHM_DEPARTMENT_PROCUREMENT_WEBHOOK_URL=
LHM_DEPARTMENT_SUPPORT_WEBHOOK_URL=
LHM_DEPARTMENT_COMPLIANCE_WEBHOOK_URL=

# Agent-Reach public search requires separately installing the verified GitHub v1.6+ CLI\n# INSIDE the isolated Linux Computer Runner; no account cookies or secrets are auto-imported.\n# See docs/CURATED_GITHUB_TOOL_STACK.md.\n\n# GrokBot-style shared Computer Agent pilot: only these exact HTTPS hosts are
# available to Content / Sales / QA browsers; global and role scopes intersect.
# Never include URLs, credentials or channel IDs in git; configure locally.
LHM_COMPUTER_CONTENT_ALLOWED_HOSTS=
LHM_COMPUTER_SALES_ALLOWED_HOSTS=
LHM_COMPUTER_QUALITY_ALLOWED_HOSTS=
# Explicit Content publication destination IDs from GET /tools/postiz/channels.
# An API key alone cannot authorize arbitrary publishing destinations.
LHM_CONTENT_POSTIZ_ALLOWED_CHANNEL_IDS=

# Optional Agent Office read-only pilot. Never commit/print the per-worker bearer token.
# Copy ONLY from a trusted LOCAL Agent Office session; no public URL or remote host.
# Required as a set; empty = bridge disabled with truthful "not_configured" status.
# See docs/AGENT_OFFICE_READONLY_BRIDGE.md before enabling.
LHM_AGENT_OFFICE_HOOK_URL=
LHM_AGENT_OFFICE_WORKER_ID=
LHM_AGENT_OFFICE_HOOK_TOKEN=
