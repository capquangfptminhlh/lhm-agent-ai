# Local development only. Do not commit a real API key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# Default is DeepSeek for backward compatibility; select openrouter for free-first.
LHM_LLM_PROVIDER=deepseek
# Free router may choose different models across requests.
# For consistent quality you may pin a vetted provider/model:free slug instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Local safety limits; account-wide OpenRouter usage may be higher.
LHM_OPENROUTER_24H_LIMIT=40
LHM_OPENROUTER_1M_LIMIT=15
# Default deny sending common personal-contact data to free model providers.
LHM_OPENROUTER_ALLOW_CONTACT_DATA=0
LHM_DB_PATH=./lhm.sqlite3
LHM_ACTIVE_WORKSPACE=demo
# Optional access token; required before exposure outside localhost.
LHM_ADMIN_TOKEN=
# Reserve an upper-bound amount for each concurrent task. Remaining reservation released at completion.
LHM_TASK_RESERVE_USD=0.02

# Advanced model is disabled by default. It costs more.
LHM_ALLOW_PRO=0

# Tool Hub: pilot integration ONLY for this one workspace.
# For real SaaS use per-customer OAuth, encrypted credential vault, and permissions.
LHM_TOOLS_WORKSPACE=demo

# Postiz (https://docs.postiz.com/public-api/introduction)
# Cloud example: https://api.postiz.com/public/v1
# Self-host: put the verified Postiz instance public API base here.
LHM_POSTIZ_API_KEY=
LHM_POSTIZ_BASE_URL=https://api.postiz.com/public/v1

# WordPress: create an Application Password in WordPress (HTTPS required).
LHM_WP_URL=
LHM_WP_USER=
LHM_WP_APP_PASSWORD=

# Activepieces: create a Webhook trigger Flow and paste its HTTPS URL.
LHM_ACTIVEPIECES_WEBHOOK_URL=