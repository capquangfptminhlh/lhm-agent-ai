# The browser and terminal run in a DEDICATED non-root sidecar.
# Image is large because Chromium and its system dependencies are included.
# This is still a shared OS namespace unless deployed one container per Agent.
FROM mcr.microsoft.com/playwright/python:v1.58.0-noble
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git ripgrep \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir "fastapi>=0.115,<1" "uvicorn>=0.30,<1" "playwright==1.58.0" "httpx>=0.27,<1"
COPY computer_executor.py ./
RUN useradd --system --uid 10001 --create-home lhmrunner \
    && mkdir -p /agent-data \
    && chown 10001:10001 /agent-data
USER 10001
EXPOSE 7781
CMD ["python","-m","uvicorn","computer_executor:runner","--host","0.0.0.0","--port","7781","--workers","1"]
